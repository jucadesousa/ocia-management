# Supabase — get these from your Supabase project dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service role key — server-side only, never expose to client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Prisma database connection — get from Supabase → Settings → Database
# Use the "Transaction" pooler connection string for DATABASE_URL
DATABASE_URL=postgresql://postgres.your-project-id:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Use the direct (non-pooled) connection string for migrations
DIRECT_URL=postgresql://postgres.your-project-id:password@aws-0-us-east-1.pooler.supabase.com:5432/postgres
